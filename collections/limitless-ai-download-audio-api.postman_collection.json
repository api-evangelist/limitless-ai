          "name": "Downloads audio for a specified time range.",
          "request": {
            "name": "Downloads audio for a specified time range.",
            "description": {
              "content": "Downloads audio in Ogg Opus format for a given time range from the specified audio source. The requested time range must be 2 hours (7,200,000 ms) or less.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "download-audio"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "audioSource",
                  "value": "pendant",
                  "description": "Audio source to download from."
                },
                {
                  "disabled": false,
                  "key": "startMs",
                  "value": "<integer>",
                  "description": "(Required) Start time in milliseconds. Must be non-negative and less than endMs."
                },
                {
                  "disabled": false,
                  "key": "endMs",
                  "value": "<integer>",
                  "description": "(Required) End time in milliseconds. Must be non-negative and greater than startMs. The duration between startMs and endMs cannot exceed 2 hours (7,200,000 ms)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "audio/ogg"
              }
