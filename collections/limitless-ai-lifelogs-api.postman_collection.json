        {
          "id": "2f0192a4-aa22-4fa1-a961-466985f717f3",
          "name": "Returns a list of lifelogs.",
          "request": {
            "name": "Returns a list of lifelogs.",
            "description": {
              "content": "Returns a list of lifelogs based on specified time range or date. If a search parameter is provided, performs hybrid search across the lifelogs. Pagination is not supported when using the search parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "lifelogs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "IANA timezone specifier. If missing, UTC is used."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "Will return all entries beginning on a date in the given timezone (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Start datetime in modified ISO-8601 format (YYYY-MM-DD or YYYY-MM-DD HH:mm:SS). Timezones/offsets will be ignored."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "End datetime in modified ISO-8601 format (YYYY-MM-DD or YYYY-MM-DD HH:mm:SS). Timezones/offsets will be ignored."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for pagination to retrieve the next set of entries. Will not work when `search` parameter is provided."
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "desc",
                  "description": "Sort direction for entries."
                },
                {
                  "disabled": false,
                  "key": "includeMarkdown",
                  "value": "true",
                  "description": "Whether to include markdown content in the response."
                },
                {
                  "disabled": false,
                  "key": "includeHeadings",
                  "value": "true",
                  "description": "Whether to include headings in the response."
                },
                {
                  "disabled": false,
                  "key": "isStarred",
                  "value": "<boolean>",
                  "description": "Filter entries by their starred status."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of entries to return. Upper limit is 100."
                },
                {
                  "disabled": false,
                  "key": "includeContents",
                  "value": "true",
                  "description": "Whether to include structured contents in the response. When false, the contents array will be empty. Note that contents are automatically excluded when more than 25 results are returned, regardless of this parameter."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Search query to perform hybrid search across lifelogs. When provided, other filtering parameters are applied as additional constraints. You cannot paginate requests when using this parameter. Upper limit of 100 results. Hybrid search is a combination of keyword search and semantic search; you can therefore send:\n- semantic queries, like \"place bob recommended at dinner\"\n- boolean keyword search, like \"blue OR red\"\n(While \"AND\" queries are supported, sending \"red AND blue\" is the same as sending \"red blue\").\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": null
          },
